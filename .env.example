APP_NAME=exapp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=exapp
DB_USERNAME=exapp
DB_PASSWORD=secret

# ----------------------------------------------------------------
# Cache / Queue / Session
# ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
# カンマ区切りで複数指定可
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------
# Mail (開発時はlogドライバで十分)
# ----------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@exapp.example"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------
# Google連携 / Firebase
# ----------------------------------------------------------------
# Firebase Admin SDK用プロジェクトID
FIREBASE_PROJECT_ID=your_project_id
# サービスアカウントJSONファイルへのパス（storage/app/ 等に配置）
# 本番のコンテナ環境では環境変数に文字列で登録する
FIREBASE_CREDENTIALS={aaa:"aaa",bbbb:"bbbbb",....}

# ----------------------------------------------------------------
# Sanctum トークン設定
# ----------------------------------------------------------------
# Sanctum APIトークンの有効期限（日数）
SANCTUM_TOKEN_EXPIRATION_DAYS=30

# ----------------------------------------------------------------
# Gemin設定
# ユーザー側の設定値をDBに持つので環境変数ではAPIキーは持たない
# ライブラリの初期化のために必要なのでダミーをおいておく
# ----------------------------------------------------------------
GEMINI_API_KEY=dummy-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=60
GOOGLE_TRANSLATE_API_KEY=your_key_here
